        "AuthorizationPolicy": "default"
      },
      "project-route": {
        "ClusterId": "project-cluster",
        "Match": {
          "Path": "/api/project/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "generator-route": {
        "ClusterId": "generator-cluster",
        "Match": {
          "Path": "/api/generator/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "events-route": {
        "ClusterId": "events-cluster",
        "Match": {
          "Path": "/api/events/{**catch-all}"
        }
      },
      "publish-route": {
        "ClusterId": "publish-cluster",
        "Match": {
          "Path": "/api/publish/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "templates-route": {
        "ClusterId": "templates-cluster",
        "Match": {
          "Path": "/api/templates/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      }
    },
